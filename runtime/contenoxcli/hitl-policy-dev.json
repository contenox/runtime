{
  "compute": {
    "maxToolCalls": 500,
    "maxTokens": 4000000,
    "onExhausted": "finish_stuck"
  },
  "default_action": "allow",
  "rules": [
    {
      "tools": "native-git",
      "tool": "git_blame",
      "action": "allow"
    },
    {
      "tools": "native-git",
      "tool": "git_branch_list",
      "action": "allow"
    },
    {
      "tools": "native-git",
      "tool": "git_show",
      "action": "allow"
    },
    {
      "tools": "native-git",
      "tool": "git_log",
      "action": "allow"
    },
    {
      "tools": "native-git",
      "tool": "git_diff",
      "action": "allow"
    },
    {
      "tools": "native-git",
      "tool": "git_status",
      "action": "allow"
    },
    {
      "tools": "native-git",
      "tool": "git_restore",
      "action": "approve"
    },
    {
      "tools": "native-git",
      "tool": "git_checkout_branch",
      "action": "approve"
    },
    {
      "tools": "native-git",
      "tool": "git_commit",
      "action": "approve"
    },
    {
      "tools": "native-git",
      "tool": "git_add",
      "action": "allow"
    },
    {
      "tools": "local_shell",
      "tool": "local_shell",
      "action": "deny",
      "when": [
        {
          "key": "command",
          "op": "command_blacklist",
          "value": "mkfs,mke2fs,fdisk,shred,wipefs"
        }
      ]
    },
    {
      "tools": "local_shell",
      "tool": "local_shell",
      "action": "allow",
      "when": [
        {
          "key": "command",
          "op": "command_prefix_allowlist",
          "value": "git status,git diff,git log,git show,git branch --list,git branch -a,git branch -v,git rev-parse,git ls-files,git describe,git rev-list,git merge-base,git blame,git grep,git remote -v,npm test,npm run test,npm run build,npm run lint,npm run typecheck,npm ls"
        }
      ]
    },
    {
      "tools": "local_shell",
      "tool": "local_shell",
      "action": "approve",
      "when": [
        {
          "key": "command",
          "op": "command_ask_always",
          "value": "rm,sudo,dd,chmod,chown"
        }
      ]
    },
    {
      "tools": "local_shell",
      "tool": "local_shell",
      "action": "approve",
      "when": [
        {
          "key": "args",
          "op": "no_command_substitution",
          "value": ""
        }
      ]
    },
    {
      "tools": "local_shell",
      "tool": "local_shell",
      "action": "approve"
    },
    {
      "tools": "shell_session",
      "tool": "shell_session_read",
      "action": "allow"
    }
  ],
  "attention": {
    "allowAgentAnswers": true,
    "maxAgentAnswers": 5
  }
}
